<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RemoteEternal.Core\RemoteEternal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <!-- SharpGen (dep do Vortice) exige System.Text.Json 9.0.1; referência explícita para implantá-lo no publish self-contained -->
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RemoteEternal</AssemblyName>
    <RootNamespace>RemoteEternal.App</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>

  <!-- Build/dev normal: copia as DLLs FFmpeg para a saída (comportamento atual). -->
  <ItemGroup Condition="Exists('..\..\libs\ffmpeg\bin') And '$(PublishSingleFile)' != 'true'">
    <None Include="..\..\libs\ffmpeg\bin\*.dll" CopyToOutputDirectory="PreserveNewest" Link="ffmpeg\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Publicação single-file: embute as DLLs FFmpeg como recursos para extração no runtime
       (FfmpegLibrary extrai para <BaseDirectory>\ffmpeg na primeira execução). -->
  <ItemGroup Condition="Exists('..\..\libs\ffmpeg\bin') And '$(PublishSingleFile)' == 'true'">
    <EmbeddedResource Include="..\..\libs\ffmpeg\bin\*.dll" LogicalName="ffmpeg.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Publicação single-file: ScreenRecorderLib.dll é um assembly mixed-mode (C++/CLI, COR20 sem ILONLY).
       O runtime .NET não suporta carregar mixed-mode de dentro do bundle single-file
       (System.BadImageFormatException em SessionHost.StopCapture/StopAsync).
       Copia a DLL do pacote para a saída ao lado do exe e exclui do bundle.
       Nota: versão deve acompanhar o PackageReference de ScreenRecorderLib acima. -->
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true' And Exists('$(NuGetPackageRoot)screenrecorderlib\6.6.0\build\x64\ScreenRecorderLib.dll')">
    <None Include="$(NuGetPackageRoot)screenrecorderlib\6.6.0\build\x64\ScreenRecorderLib.dll"
          Link="ScreenRecorderLib.dll"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Visible="false" />
  </ItemGroup>

  <!-- A mesma DLL também é injetada como Reference (mixed-mode) pelo ScreenRecorderLib.targets do pacote.
       Sem Private=false, ela entraria em ReferenceCopyLocalPaths e seria embutida no bundle (duplicando a
       None acima, que fica fora do bundle). Isso impede o copy-local apenas na publicação single-file. -->
  <Target Name="MarkScreenRecorderLibNotCopyLocal"
          AfterTargets="InjectReference"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <Reference Update="ScreenRecorderLib">
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>


  <!-- SharpGen (dep do Vortice) exige System.Text.Json 9.0.1, mas o publish self-contained
       .NET 8 implanta a versão 8.0.x do framework. Copiamos a DLL 9.0.1 do pacote NuGet
       após o publish para alinhar com o deps.json (evita "Could not load System.Text.Json 9.0.0.0"). -->
  <Target Name="DeploySystemTextJson" AfterTargets="Publish" Condition="Exists('$(NuGetPackageRoot)system.text.json/9.0.1/lib/net8.0/System.Text.Json.dll')">
    <ItemGroup>
      <_StjDlls Include="$(NuGetPackageRoot)system.text.json/9.0.1/lib/net8.0/System.Text.Json.dll" />
      <_StjDlls Include="$(NuGetPackageRoot)system.text.encodings.web/9.0.1/lib/net8.0/System.Text.Encodings.Web.dll" />
      <_StjDlls Include="$(NuGetPackageRoot)system.io.pipelines/9.0.1/lib/net8.0/System.IO.Pipelines.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_StjDlls)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
    <Message Text="System.Text.Json + Encodings.Web + Pipelines 9.0.1 copiados para o publish." Importance="High" />
  </Target>
</Project>
