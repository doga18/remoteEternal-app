<Window x:Class="RemoteEternal.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteEternal" Height="560" Width="840"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#FF1E1F24"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF2A2C33"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2F6FDB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFE8EAF0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA0AE"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF23252C"/>
            <Setter Property="Foreground" Value="#FFE8EAF0"/>
            <Setter Property="BorderBrush" Value="#FF3A3D46"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF23252C"/>
            <Setter Property="Foreground" Value="#FFE8EAF0"/>
            <Setter Property="BorderBrush" Value="#FF3A3D46"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A86E8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF3A3D46"/>
                    <Setter Property="Foreground" Value="#FF777C89"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF3A3D46"/>
            <Setter Property="Foreground" Value="#FFE8EAF0"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#FF3A3D46"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid x:Name="ConnectPanel" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="28">
                <StackPanel>
                    <TextBlock Text="RemoteEternal" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Acesso remoto simples e ilimitado" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,18"/>
                    <TextBlock Text="URL da API" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="TxtApiUrl" Text="https://remoteeternal-api.onrender.com"/>
                    <Grid x:Name="UpdatePanel" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnUpdate" Grid.Column="0" Content="Atualizar" Padding="12,6" Margin="0,4,6,4" Click="OnUpdateClick"/>
                        <Button x:Name="BtnUpdateMenu" Grid.Column="1" Content="▾" Style="{StaticResource GhostButton}" Padding="10,6" Margin="0,4,0,4" Click="OnUpdateMenuClick">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="Copiar link da atualização" Click="OnCopyUpdateLinkClick"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock x:Name="TxtUpdateInfo" Grid.Column="2" Foreground="#FF9DD6FF" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="TxtConnectError" Foreground="#FFFF8A80" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <Button x:Name="BtnConnectServer" Content="Conectar servidor" Click="OnConnectServerClick"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="MainPanel" Visibility="Collapsed" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="#FF4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Conectado ao servidor" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtServerLabel" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Button x:Name="BtnDisconnect" Content="Desconectar" Style="{StaticResource GhostButton}" Padding="10,4" Margin="16,0,0,0" Click="OnDisconnectClick" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Este computador — ser controlado" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="SEU ID" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
                        <TextBlock x:Name="TxtHostId" Text="—" FontFamily="Consolas" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Modo de acesso" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                        <RadioButton x:Name="RadAssisted" Content="Assistido (exige aprovação)" GroupName="AccessMode" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                        <RadioButton x:Name="RadUnassisted" Content="Não assistido (ID + senha)" GroupName="AccessMode" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtHostPassLabel" Text="Senha de acesso" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                        <PasswordBox x:Name="TxtHostPass"/>
                        <Button x:Name="BtnToggleHost" Content="Iniciar acesso" Click="OnToggleHostClick"/>
                        <TextBlock x:Name="TxtHostStatus" Text="Aguardando conexões." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Controlar outro computador" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="ID do computador" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
                        <TextBox x:Name="TxtRemoteId" MaxLength="10"/>
                        <TextBlock Text="Senha" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                        <PasswordBox x:Name="TxtRemotePass"/>
                        <Button x:Name="BtnConnectRemote" Content="Conectar" Click="OnConnectRemoteClick"/>
                        <TextBlock x:Name="TxtRemoteStatus" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Expander Grid.Row="2" Header="Diagnóstico" Foreground="{StaticResource TextBrush}"
                      Background="{StaticResource PanelBrush}" Margin="0,10,0,0" IsExpanded="False">
                <TextBox x:Name="TxtDiagnostics" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         MaxHeight="140" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" BorderThickness="0"/>
            </Expander>
        </Grid>
    </Grid>
</Window>