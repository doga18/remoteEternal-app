<Window x:Class="RemoteEternal.App.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteEternal - Conectando..." Height="720" Width="1080"
        WindowStartupLocation="CenterOwner" Background="#FF141519">
    <Window.Resources>
        <SolidColorBrush x:Key="BarBrush" Color="#FF1E1F24"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFE8EAF0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA0AE"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2F6FDB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A86E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2A2C33"/>
            <Setter Property="Foreground" Value="#FFE8EAF0"/>
            <Setter Property="BorderBrush" Value="#FF3A3D46"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE8EAF0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource BarBrush}" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🖥" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitle" Text="Conectando..." Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,16,0"/>
                <TextBlock Text="Monitor:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <ComboBox x:Name="CboMonitor" MinWidth="150" SelectionChanged="OnMonitorChanged"/>
                <CheckBox x:Name="ChkAudio" Content="Áudio" IsChecked="True" Checked="OnAudioChanged" Unchecked="OnAudioChanged"/>
                <Button x:Name="BtnFullscreen" Content="Tela cheia" Click="OnFullscreenClick"/>
                <Button x:Name="BtnDisconnect" Content="Desconectar" Background="#FF8A3B3B" Click="OnDisconnectClick"/>
                <TextBlock x:Name="TxtStats" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0" FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Background="#FF0E0F12">
            <TextBlock x:Name="TxtStatus" Text="Conectando..." Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
            <Image x:Name="RemoteImage" Stretch="Uniform" Visibility="Collapsed"
                   MouseMove="OnImageMouseMove" MouseDown="OnImageMouseDown" MouseUp="OnImageMouseUp"
                   MouseWheel="OnImageMouseWheel" Focusable="True"/>
        </Grid>

        <Expander Grid.Row="2" Header="Diagnóstico" Background="{StaticResource BarBrush}"
                  Foreground="{StaticResource TextBrush}" IsExpanded="False">
            <TextBox x:Name="TxtDiagnostics" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     MaxHeight="110" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" Background="#FF141519"
                     Foreground="{StaticResource TextBrush}" BorderThickness="0"/>
        </Expander>
    </Grid>
</Window>
