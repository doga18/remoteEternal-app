api/

# Dependências e diretórios de build
node_modules/
bin/
obj/
publish/
libs/

# Diretórios locais do ambiente de trabalho (não fazem parte do produto)
lancedb/
models/
.tools/
.opencode/

# Arquivos locais de dados / ambiente
*.db
*.db-journal
.env
.DS_Store

# Exemplo local do usuário (fora do produto)
connect.js

